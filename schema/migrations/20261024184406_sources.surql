DEFINE FUNCTION OVERWRITE fn::feature::allow($key: string, $variant: string, $user: record) -> object { LET $flag = (SELECT * FROM ONLY _00_feature_flag WHERE key = $key LIMIT 1); IF $flag = NONE { THROW 'Unknown flag: ' + $key }; IF !($variant INSIDE ($flag.variants ?? [])) { THROW "Unknown variant '" + $variant + "' for flag '" + $key + "'" }; LET $uid = <string> $user; LET $rules = $flag.rules ?? []; LET $has = array::len(array::filter($rules, |$r: any| { RETURN $r.kind = 'allowlist' AND $r.variant = $variant })) > 0; LET $next = (IF $has { array::map($rules, |$r: any| { RETURN (IF $r.kind = 'allowlist' AND $r.variant = $variant { { kind: 'allowlist', variant: $r.variant, users: array::distinct(array::append(array::map($r.users ?? [], |$x: any| <string> $x), $uid)), priority: $r.priority ?? 10 } } ELSE { $r }) }) } ELSE { array::append($rules, { kind: 'allowlist', variant: $variant, users: [$uid], priority: 10 }) }); UPDATE _00_feature_flag SET rules = $next WHERE key = $key; RETURN fn::feature::reassign($key, $user); } PERMISSIONS WHERE $auth.id != NONE AND array::len((SELECT VALUE id FROM _00_admin WHERE user = $auth.id LIMIT 1)) > 0;
DEFINE FUNCTION OVERWRITE fn::feature::disallow($key: string, $user: record) -> object { LET $flag = (SELECT * FROM ONLY _00_feature_flag WHERE key = $key LIMIT 1); IF $flag = NONE { THROW 'Unknown flag: ' + $key }; LET $uid = <string> $user; LET $next = array::map($flag.rules ?? [], |$r: any| { RETURN (IF $r.kind = 'allowlist' { { kind: 'allowlist', variant: $r.variant, users: array::filter(array::map($r.users ?? [], |$x: any| <string> $x), |$x: any| $x != $uid), priority: $r.priority ?? 10 } } ELSE { $r }) }); UPDATE _00_feature_flag SET rules = $next WHERE key = $key; RETURN fn::feature::reassign($key, $user); } PERMISSIONS WHERE $auth.id != NONE AND array::len((SELECT VALUE id FROM _00_admin WHERE user = $auth.id LIMIT 1)) > 0;
DEFINE FUNCTION OVERWRITE fn::feature::materialize($key: string) -> object { LET $flag = (SELECT * FROM ONLY _00_feature_flag WHERE key = $key LIMIT 1); IF $flag = NONE {
DELETE _00_user_feature WHERE key = $key;
RETURN { key: $key, found: false, users: 0 };
}; LET $ranked = fn::feature::rules($flag); LET $users = (SELECT VALUE id FROM user); LET $expected = (_00_module_state:feature_user_count).count ?? 0; IF array::len($users) < $expected { THROW 'fn::feature::materialize can only see ' + <string> array::len($users) + ' of ' + <string> $expected + ' users, so it would leave most of them on a stale variant. ' + "The `user` table's SELECT permission is hiding rows from this admin: widen it, " + 'or change the flag with `spky flag` instead.' }; FOR $u IN $users { fn::feature::assign($flag, $ranked, $u) }; RETURN { key: $key, found: true, users: array::len($users) }; } PERMISSIONS WHERE $auth.id != NONE AND array::len((SELECT VALUE id FROM _00_admin WHERE user = $auth.id LIMIT 1)) > 0;
DEFINE FIELD OVERWRITE evaluated_at ON _00_user_feature TYPE datetime DEFAULT time::now() PERMISSIONS FULL;
DEFINE FIELD OVERWRITE assigned_to ON job TYPE none | record<material | call | fetcher> PERMISSIONS FOR select, create WHERE true, FOR update WHERE false;
DEFINE EVENT OVERWRITE _00_dbsp_cleanup ON _00_query WHEN $event = 'DELETE' THEN { LET $payload = { id: <string> $before.id }; LET $result = (SELECT * FROM http::post($sp00ky_endpoint + '/view/unregister', $payload, { Authorization: 'Bearer ' + $sp00ky_secret }) TIMEOUT 10s); };
DEFINE EVENT OVERWRITE course_deleted ON course WHEN $event = 'DELETE' THEN { DELETE material WHERE course = $before.id; DELETE call WHERE course = $before.id; DELETE fetcher WHERE course = $before.id; };

-- Added
DEFINE FUNCTION OVERWRITE fn::feature::assign($flag: object, $ranked: array, $user: record) -> string { LET $key = $flag.key; LET $uid = <string> $user; LET $matched = array::filter($ranked, |$c: any| { RETURN (IF $c.variant = NONE { false } ELSE IF $c.kind = 'allowlist' { $uid INSIDE $c.users } ELSE IF $c.kind = 'rollout' { $c.percent > 0 AND fn::feature::hash($key, $uid) < $c.percent } ELSE { false }) }); LET $best = array::min(array::map($matched, |$c: any| ($c.rank))); LET $win = array::first(array::filter($matched, |$c: any| ($c.rank = $best))); LET $variant = (IF $win = NONE { $flag.default_variant ?? 'off' } ELSE { $win.variant }); LET $payload = ($flag.payloads ?? {  })[$variant]; UPSERT _00_user_feature SET evaluated_at = (IF variant = $variant AND payload = $payload AND evaluated_at != NONE { evaluated_at } ELSE { time::now() }), user = $user, key = $key, variant = $variant, payload = $payload WHERE user = $user AND key = $key; RETURN $variant; } PERMISSIONS WHERE $auth.id != NONE AND array::len((SELECT VALUE id FROM _00_admin WHERE user = $auth.id LIMIT 1)) > 0;
DEFINE FUNCTION OVERWRITE fn::feature::reassign($key: string, $user: record) -> object { LET $flag = (SELECT * FROM ONLY _00_feature_flag WHERE key = $key LIMIT 1); IF $flag = NONE OR record::tb($user) != 'user' { RETURN { key: $key, found: $flag != NONE, users: 0 } }; fn::feature::assign($flag, fn::feature::rules($flag), $user); RETURN { key: $key, found: true, users: 1 }; } PERMISSIONS WHERE $auth.id != NONE AND array::len((SELECT VALUE id FROM _00_admin WHERE user = $auth.id LIMIT 1)) > 0;
DEFINE FUNCTION OVERWRITE fn::feature::rules($flag: object) -> array { LET $rules = (IF $flag.enabled ?? true { $flag.rules ?? [] } ELSE { [] }); RETURN array::map($rules, |$r: any, $i: any| { RETURN { rank: <int> ($r.priority ?? 100) * 100000 + $i, kind: $r.kind, variant: $r.variant, percent: <int> ($r.percent ?? 0), users: array::map($r.users ?? [], |$x: any| <string> $x) } }); } PERMISSIONS WHERE $auth.id != NONE AND array::len((SELECT VALUE id FROM _00_admin WHERE user = $auth.id LIMIT 1)) > 0;
DEFINE TABLE OVERWRITE _00_wf_event TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE _00_wf_instance TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE owner != NONE AND owner = $auth.id, FOR create, update, delete NONE;
DEFINE TABLE OVERWRITE _00_wf_step TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select WHERE instance.owner != NONE AND instance.owner = $auth.id, FOR create, update, delete NONE;
DEFINE TABLE OVERWRITE fetch_run TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, delete WHERE owner = $auth.id, FOR create, update WHERE false;
DEFINE TABLE OVERWRITE fetcher TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, update, delete WHERE owner = $auth.id, FOR create WHERE owner = $auth.id AND course.owner = $auth.id;
