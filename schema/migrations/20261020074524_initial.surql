DEFINE TABLE OVERWRITE _00_push_credential TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE _00_push_message TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, delete WHERE $auth.id != NONE AND created_by = <string> $auth.id, FOR create WHERE $auth.id != NONE AND $access != '_00_impersonate' AND created_by = <string> $auth.id AND to = [<string> $auth.id], FOR update WHERE $auth.id != NONE AND created_by = <string> $auth.id AND status INSIDE ['pending', 'cancelled'];
DEFINE TABLE OVERWRITE _00_push_subscription TYPE NORMAL SCHEMAFULL PERMISSIONS FOR select, create, update, delete WHERE $auth.id != NONE AND $access != '_00_impersonate' AND auth_id = <string> $auth.id;
DEFINE TABLE OVERWRITE _00_query TYPE ANY SCHEMALESS PERMISSIONS FOR select, update, delete WHERE $auth.id != NONE AND auth_id = <string> $auth.id AND fn::sp00ky::session_live() OR auth_id INSIDE ['anon', ''] AND subscribers.*.id CONTAINS <string> session::id(), FOR create NONE;
