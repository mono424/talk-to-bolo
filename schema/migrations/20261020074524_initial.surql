DEFINE EVENT OVERWRITE _00_dbsp_cleanup ON _00_query WHEN $event = 'DELETE' THEN { LET $payload = { id: <string> $before.id }; LET $result = http::post($sp00ky_endpoint + '/view/unregister', $payload, { Authorization: 'Bearer ' + $sp00ky_secret }); };
DEFINE EVENT OVERWRITE call_deleted ON call WHEN $event = 'DELETE' THEN { DELETE call_turn WHERE call = $before.id };
DEFINE EVENT OVERWRITE course_deleted ON course WHEN $event = 'DELETE' THEN { DELETE material WHERE course = $before.id; DELETE call WHERE course = $before.id; };
DEFINE EVENT OVERWRITE material_deleted ON material WHEN $event = 'DELETE' THEN { DELETE chunk WHERE material = $before.id; DELETE asset WHERE material = $before.id; DELETE source_part WHERE material = $before.id; };
