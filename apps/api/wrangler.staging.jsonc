{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talktobolo-api-staging",
  "account_id": "555c6a13a72fe1d5f31197c8986813d5",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Service paths run before the existing web app's Custom Domain.
  "routes": [
    { "pattern": "talktobolo.stg.spky.cloud/api/*", "zone_id": "599884de492f1f2b826f57306e93ed12" },
    { "pattern": "talktobolo.stg.spky.cloud/mcp", "zone_id": "599884de492f1f2b826f57306e93ed12" },
    { "pattern": "talktobolo.stg.spky.cloud/material-assets/*", "zone_id": "599884de492f1f2b826f57306e93ed12" },
    { "pattern": "talktobolo.stg.spky.cloud/llm/*", "zone_id": "599884de492f1f2b826f57306e93ed12" },
    { "pattern": "talktobolo.stg.spky.cloud/health", "zone_id": "599884de492f1f2b826f57306e93ed12" },
    { "pattern": "talktobolo.stg.spky.cloud/oauth/*", "zone_id": "599884de492f1f2b826f57306e93ed12" },
    { "pattern": "talktobolo.stg.spky.cloud/.well-known/oauth*", "zone_id": "599884de492f1f2b826f57306e93ed12" }
  ],

  // server-schema.surql is imported as a string.
  "rules": [{ "type": "Text", "globs": ["**/*.surql"], "fallthrough": true }],

  "ai": { "binding": "AI" },
  "workflows": [
    {
      "name": "talktobolo-ingest-staging",
      "binding": "INGEST",
      "class_name": "IngestMaterial"
    }
  ],

  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },

  "vars": {
    "APP_ORIGIN": "https://talktobolo.stg.spky.cloud",
    "API_ORIGIN": "https://talktobolo.stg.spky.cloud",
    "SURREAL_NS": "talktobolo",
    "SURREAL_DB": "main",
    "CLAUDE_MODEL": "claude-opus-5-5",
    "CLAUDE_PDF_MODEL": "claude-opus-5-5",
    "EMBEDDING_MODEL": "@cf/qwen/qwen3-embedding-0.6b"
  }

  // Deploy with --config wrangler.staging.jsonc --secrets-file <protected JSON>.
  // SURREAL_URL/USER/PASS use the hosted staging database, never .dev.vars.
  // Add Anthropic, ElevenLabs, and Agent Memory secrets when configured.
}
