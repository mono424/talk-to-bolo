# Copy to .dev.vars for `wrangler dev` (pnpm dev:api). Never commit .dev.vars.
# Local stack from `spky dev`: SurrealDB on :8666, namespace/db from sp00ky.yml.
SURREAL_URL=http://localhost:8666
SURREAL_USER=root
SURREAL_PASS=root
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
ELEVENLABS_AGENT_ID=...
# Any long random string; the same value goes to `pnpm setup:voice`.
LLM_SHARED_SECRET=...
# SurrealDB Agent Memory is a separate Context data plane, not the SQL endpoint.
# Leave both unset to use progress-limited passages without durable AI memory.
# AGENT_MEMORY_URL=https://YOUR-CONTEXT-HOST/api/v1/YOUR-CONTEXT-ID
# AGENT_MEMORY_API_KEY=...
